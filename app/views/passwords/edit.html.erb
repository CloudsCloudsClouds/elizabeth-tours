<div class="max-w-md mx-auto">
  <h1 class="text-3xl font-bold text-secondary mb-8"><%= t(".title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "card bg-base-100 shadow-md border border-base-300" do |form| %>
    <div class="card-body space-y-4">
      <div class="form-control w-full">
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t(".new_password_placeholder"), maxlength: 72, class: "input input-bordered w-full" %>
      </div>

      <div class="form-control w-full">
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t(".confirm_password_placeholder"), maxlength: 72, class: "input input-bordered w-full" %>
      </div>

      <div>
        <%= form.submit t(".save"), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
