<% content_for :title, "Tours" %>

<h1 class="text-4xl font-bold text-base-content mb-8">Tours</h1>

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% @tours.each do |tour| %>
    <div class="card card-compact bg-base-100 shadow-md border border-base-300">
      <div class="card-body">
        <h2 class="card-title text-secondary"><%= tour.name %></h2>
        <% if tour.description.present? %>
          <p class="text-base-content/70 text-sm"><%= truncate(tour.description, length: 120) %></p>
        <% end %>
        <p class="text-2xl font-bold text-primary mt-2"><%= number_to_currency(tour.base_price) %></p>
        <div class="card-actions justify-end mt-4">
          <%= link_to "View tour", tour, class: "btn btn-outline btn-secondary btn-sm" %>
          <%= link_to "Book now", new_booking_path(tour_id: tour.id), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
