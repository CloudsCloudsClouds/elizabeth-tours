<% content_for :title, @tour.name %>

<div class="max-w-3xl mx-auto">
  <div class="card bg-base-100 shadow-md border border-base-300">
    <div class="card-body">
      <h1 class="text-4xl font-bold text-secondary"><%= @tour.name %></h1>

      <% if @tour.description.present? %>
        <p class="text-base-content/70 mt-4 text-lg leading-relaxed"><%= @tour.description %></p>
      <% end %>

      <div class="divider"></div>

      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-base-content/60">Price per person</p>
          <p class="text-3xl font-bold text-primary"><%= number_to_currency(@tour.base_price) %></p>
        </div>

        <div class="flex gap-3">
          <%= link_to "Back to tours", tours_path, class: "btn btn-ghost" %>
          <%= link_to "Book this tour", new_booking_path(tour_id: @tour.id), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
