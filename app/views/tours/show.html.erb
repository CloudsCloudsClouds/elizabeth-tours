<% content_for :title, @tour.name %>

<div class="max-w-4xl mx-auto">
  <div class="card bg-base-100 shadow-md border border-base-300">
    <% if @tour.images.attached? && @tour.images.any? %>
      <div data-controller="carousel" data-carousel-index-value="0">
        <figure>
          <div data-action="mouseenter->carousel#pause mouseleave->carousel#resume"
               class="carousel w-full">
            <% @tour.images.each do |image| %>
              <div data-carousel-target="slide" class="carousel-item w-full">
                <%= image_tag image, class: "w-full" %>
              </div>
            <% end %>
          </div>
        </figure>
        <% if @tour.images.many? %>
          <div class="flex justify-center items-center gap-3 py-3">
            <button data-action="carousel#previous" class="btn btn-outline btn-sm">❮</button>
            <span class="text-sm text-base-content/60"><%= pluralize(@tour.images.count, "image") %></span>
            <button data-action="carousel#next" class="btn btn-outline btn-sm">❯</button>
          </div>
        <% end %>
      </div>
    <% else %>
      <figure>
        <div class="w-full h-64 bg-base-200 flex items-center justify-center">
          <span class="text-error font-semibold">No images</span>
        </div>
      </figure>
    <% end %>

    <div class="card-body">
      <h1 class="text-4xl font-bold text-secondary"><%= @tour.name %></h1>

      <% if @tour.description.present? %>
        <p class="text-base-content/70 mt-4 text-lg leading-relaxed"><%= @tour.description %></p>
      <% end %>

      <div class="divider"></div>

      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-base-content/60">Price per person</p>
          <p class="text-3xl font-bold text-primary"><%= number_to_currency(@tour.base_price) %></p>
        </div>

        <div class="flex gap-3">
          <%= link_to "Back to tours", tours_path, class: "btn btn-ghost" %>
          <%= link_to "Book this tour", new_booking_path(tour_id: @tour.id), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
