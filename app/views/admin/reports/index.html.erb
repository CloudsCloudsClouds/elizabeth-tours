<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800">Reports</h1>
    <%= link_to "Export PDF", admin_reports_path(format: :pdf), class: "btn btn-primary" %>
  </div>

  <style>
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    th, td { border: 1px solid #ccc; padding: 6px; text-align: left; font-size: 11px; }
    th { background: #f5f5f5; }
    .report-section { margin-bottom: 30px; page-break-inside: avoid; }
    h2 { font-size: 16px; margin-bottom: 10px; }
  </style>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">

    <div class="report-section bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Revenue Over Time</h2>
      <table>
        <thead><tr><th>Month</th><th>Revenue</th></tr></thead>
        <tbody>
          <% @revenue_over_time.each do |month, revenue| %>
            <tr><td><%= month %></td><td><%= number_to_currency(revenue) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="report-section bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Revenue by Tour</h2>
      <table>
        <thead><tr><th>Tour</th><th>Revenue</th></tr></thead>
        <tbody>
          <% @revenue_by_tour.each do |tour, revenue| %>
            <tr><td><%= tour %></td><td><%= number_to_currency(revenue) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="report-section bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Revenue by Status</h2>
      <table>
        <thead><tr><th>Status</th><th>Revenue</th></tr></thead>
        <tbody>
          <% @revenue_by_status.each do |status, revenue| %>
            <tr><td><%= status.humanize %></td><td><%= number_to_currency(revenue) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="report-section bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Average Group Size by Tour</h2>
      <table>
        <thead><tr><th>Tour</th><th>Avg Guests</th></tr></thead>
        <tbody>
          <% @avg_group_size.each do |tour, avg| %>
            <tr><td><%= tour %></td><td><%= number_with_precision(avg, precision: 1) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="report-section bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Bookings by Day of Week</h2>
      <table>
        <thead><tr><th>Day</th><th>Bookings</th></tr></thead>
        <tbody>
          <% @bookings_by_dow.each do |day, count| %>
            <tr><td><%= day %></td><td><%= count %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="report-section bg-white rounded-lg shadow-md p-6 xl:col-span-2">
      <h2 class="text-xl font-semibold mb-4 text-gray-800">Upcoming Bookings</h2>
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>Date</th>
              <th>Tour</th>
              <th>Customer</th>
              <th>Guests</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_bookings.each do |booking| %>
              <tr>
                <td><%= booking.tour_date.strftime("%b %d, %Y") %></td>
                <td><%= booking.tour.name %></td>
                <td><%= booking.user.email_address %></td>
                <td><%= booking.num_guests %></td>
                <td><span class="badge badge-<%= booking.status == 'confirmed' ? 'success' : booking.status == 'cancelled' ? 'error' : 'info' %>"><%= booking.status %></span></td>
                <td><%= number_to_currency(booking.total_price) %></td>
              </tr>
            <% end %>
            <% if @upcoming_bookings.empty? %>
              <tr><td colspan="6" class="text-center text-gray-400 py-4">No upcoming bookings</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
