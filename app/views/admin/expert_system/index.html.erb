<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 text-gray-800">Sistema Experto - Evaluar Bloqueo</h1>

  <%= form_tag admin_expert_system_path, method: :get, class: "space-y-6 bg-white p-6 rounded-lg shadow-md" do %>
    <div>
      <%= label_tag :gravity, "Gravedad (1-5)", class: "block font-medium text-gray-700 mb-1" %>
      <%= select_tag :gravity,
          options_for_select([["Leve", 1], ["Moderado", 2], ["Medio", 3], ["Grave", 4], ["Crítico", 5]], params[:gravity]),
          prompt: "Seleccionar gravedad",
          class: "select select-bordered w-full" %>
    </div>

    <div>
      <%= label_tag :description, "Descripción (opcional)", class: "block font-medium text-gray-700 mb-1" %>
      <%= text_field_tag :description, params[:description],
          placeholder: "Ej: Huelga en Tiquina",
          class: "input input-bordered w-full" %>
    </div>

    <div>
      <%= submit_tag "Evaluar", class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if @api_response %>
    <div class="mt-8 bg-gray-50 p-6 rounded-lg shadow-md border">
      <h2 class="text-xl font-semibold mb-3 text-gray-800">
        Respuesta
        <span class="text-sm font-normal text-gray-500">(Status: <%= @api_status %>)</span>
      </h2>
      <pre class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm whitespace-pre-wrap"><%= JSON.pretty_generate(JSON.parse(@api_response)) rescue @api_response %></pre>
    </div>
  <% elsif @api_error %>
    <div class="mt-8 bg-red-50 p-6 rounded-lg shadow-md border border-red-200">
      <h2 class="text-xl font-semibold mb-3 text-red-800">Error</h2>
      <p class="text-red-600"><%= @api_error %></p>
    </div>
  <% end %>
</div>
