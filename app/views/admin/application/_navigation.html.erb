<nav class="navigation">
  <%= link_to(t("administrate.navigation.back_to_app"), root_url, class: "button button--alt button--nav") if defined?(root_url) %>

  <% Administrate::Namespace.new(namespace).resources_with_index_route.each do |resource| %>
    <% dashboard = dashboard_from_resource(resource) rescue nil %>
    <% if dashboard %>
      <%= link_to(
        display_resource_name(resource),
        resource_index_route(resource),
        class: "navigation__link navigation__link--#{nav_link_state(resource)}"
      ) if accessible_action?(model_from_resource(resource), :index) %>
    <% end %>
  <% end %>

  <hr class="my-2 border-gray-200">

  <%= link_to "Reports", admin_reports_path, class: "navigation__link navigation__link--#{params[:controller] == 'admin/reports' ? 'active' : 'inactive'}" %>

  <%= link_to "Activity Log", admin_versions_path, class: "navigation__link navigation__link--#{params[:controller] == 'admin/versions' ? 'active' : 'inactive'}" %>

  <%= link_to "Expert System", admin_expert_system_path, class: "navigation__link navigation__link--#{params[:controller] == 'admin/expert_system' ? 'active' : 'inactive'}" %>
</nav>
