<%= form_with(model: booking_add_on, class: "contents") do |form| %>
  <% if booking_add_on.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(booking_add_on.errors.count, "error") %> prohibited this booking_add_on from being saved:</h2>

      <ul class="list-disc ml-6">
        <% booking_add_on.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :booking_id, class: "block font-medium mb-1" %>
    <%= form.collection_select :booking_id, Booking.all, :id, ->(b) { "Booking ##{b.id} - #{b.tour.name}" }, { include_blank: "Select a booking" }, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :add_on_id, class: "block font-medium mb-1" %>
    <%= form.collection_select :add_on_id, AddOn.all, :id, ->(a) { "#{a.name} (#{number_to_currency(a.price)})" }, { include_blank: "Select an add-on" }, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
