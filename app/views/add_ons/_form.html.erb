<%= form_with(model: add_on, class: "contents") do |form| %>
  <% if add_on.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(add_on.errors.count, "error") %> prohibited this add_on from being saved:</h2>

      <ul class="list-disc ml-6">
        <% add_on.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, class: "block font-medium mb-1" %>
    <%= form.text_field :name, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :price, class: "block font-medium mb-1" %>
    <%= form.number_field :price, step: 0.01, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :status, class: "block font-medium mb-1" %>
    <%= form.select :status, AddOn.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :tour_id, class: "block font-medium mb-1" %>
    <%= form.collection_select :tour_id, Tour.all, :id, :name, { include_blank: "Select a tour" }, class: "block shadow-sm rounded-md border border-gray-300 outline-hidden px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
