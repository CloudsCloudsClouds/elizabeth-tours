<div id="<%= dom_id add_on %>" class="w-full sm:w-auto my-5 space-y-5">
  <p class="font-medium text-gray-900"><%= add_on.name %></p>
  <p class="text-sm text-gray-500">Tour: <%= add_on.tour.name %></p>
  <div class="flex items-center gap-2">
    <p class="text-lg font-bold text-gray-900"><%= number_to_currency(add_on.price) %></p>
    <span class="inline-block rounded-md px-2 py-0.5 text-xs font-medium <%= add_on.status_available? ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-700" %>"><%= add_on.status %></span>
  </div>
</div>
