<div id="<%= dom_id booking %>" class="w-full sm:w-auto my-5 space-y-5">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
    <div>
      <p class="font-medium text-gray-900 text-lg"><%= booking.tour.name %></p>
      <p class="text-sm text-gray-500">Booked by <%= booking.user.name %> &middot; <%= l(booking.created_at, format: :long) %></p>
    </div>
    <div class="text-right">
      <p class="text-lg font-bold text-gray-900"><%= number_to_currency(booking.total_price) %></p>
      <span class="inline-block rounded-md px-2 py-0.5 text-xs font-medium mt-1 <%= booking.status == "confirmed" ? "bg-green-100 text-green-700" : booking.status == "cancelled" ? "bg-red-100 text-red-700" : "bg-yellow-100 text-yellow-700" %>"><%= booking.status %></span>
    </div>
  </div>

  <% if booking.add_ons.any? %>
    <div>
      <p class="text-sm font-medium text-gray-700 mb-1">Add-ons:</p>
      <div class="space-y-1">
        <% booking.add_ons.each do |add_on| %>
          <div class="flex items-center justify-between text-sm">
            <span class="text-gray-500"><%= add_on.name %></span>
            <span class="text-gray-700"><%= number_to_currency(add_on.price) %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if booking.note.present? %>
    <div>
      <p class="text-sm font-medium text-gray-700 mb-1">Note:</p>
      <p class="text-sm text-gray-500 whitespace-pre-wrap bg-gray-50 rounded-md p-3"><%= booking.note %></p>
    </div>
  <% end %>
</div>
